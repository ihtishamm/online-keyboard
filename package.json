{
  "name": "online-keyboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @okb/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @okb/web test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && node tools/invisible-chars.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix:chars": "node tools/invisible-chars.mjs --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
