---
import { CORE_FONTS } from "../styles/script-fonts";
import { LANGUAGES, REGIONS, isSpecialKeyboard, type Language } from "@okb/layouts";
import { nameFontClass } from "../components/fonts";
import HomeSuggestions from "../components/picker/HomeSuggestions";
import { SCRIPT_NAMES, pickerLanguage } from "../components/picker/languages";
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";

const pickerLanguages = LANGUAGES.map(pickerLanguage);
const group = (key: (l: Language) => string, names: Record<string, string>) =>
  Object.keys(names)
    .map((k) => [names[k]!, LANGUAGES.filter((l) => key(l) === k)] as const)
    .filter(([, list]) => list.length > 0);
const byRegion = group((l) => l.region, REGIONS);
// Special keyboards (IPA, pinyin tone marks) keep their own group when browsing by script too.
const byScript = [
  ...group((l) => (isSpecialKeyboard(l) ? "" : l.script), SCRIPT_NAMES),
  [REGIONS.special, LANGUAGES.filter(isSpecialKeyboard)] as const,
];
---

<Base title={`${SITE.name}: ${SITE.tagline}`} fonts={CORE_FONTS}>
  <section class="py-10 text-center">
    <h1 class="text-4xl font-semibold tracking-tight">{SITE.tagline}</h1>
    <p class="font-nastaliq mt-4 text-3xl text-accent" lang="ur" dir="rtl">
      اردو لکھیں، خوبصورتی سے
    </p>
    <p class="mx-auto mt-4 max-w-2xl text-muted">{SITE.description}</p>
  </section>

  <HomeSuggestions client:idle languages={pickerLanguages} />

  <section id="all-languages" aria-labelledby="keyboards-heading" class="group mx-auto max-w-3xl">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h2 id="keyboards-heading" class="text-xl font-semibold">
        Keyboards
      </h2>
      <fieldset class="inline-flex rounded-lg border border-border bg-surface p-0.5 text-sm">
        <legend class="sr-only">Browse by</legend>
        {(
          [
            ["region", "By region"],
            ["script", "By script"],
          ] as const
        ).map(([value, label]) => (
          <label class="cursor-pointer rounded-md px-3 py-2 text-muted has-checked:bg-accent has-checked:text-accent-fg has-focus-visible:outline-2">
            <input
              type="radio"
              name="browse"
              value={value}
              id={`browse-${value}`}
              checked={value === "region"}
              class="sr-only"
            />
            {label}
          </label>
        ))}
      </fieldset>
    </div>
    {(
      [
        ["region", byRegion],
        ["script", byScript],
      ] as const
    ).map(([mode, groups]) => (
      <div
        data-browse={mode}
        class:list={[
          "flex flex-col gap-6",
          mode === "region"
            ? "group-has-[#browse-script:checked]:hidden"
            : "hidden group-has-[#browse-script:checked]:flex",
        ]}
      >
        {groups.map(([name, list]) => (
          <section aria-label={name}>
            <h3 class="mb-2 text-sm font-semibold tracking-wide text-muted uppercase">{name}</h3>
            <ul class="grid gap-3 sm:grid-cols-2">
              {list.map((l) => (
                <li>
                  <a
                    href={`/${l.slug}`}
                    class="flex items-center justify-between rounded-xl border border-border bg-surface px-5 py-4 text-text no-underline hover:border-accent"
                  >
                    <span class="text-lg font-medium">{l.name.en} keyboard</span>
                    <span
                      class={`${nameFontClass(l.fonts[0]!)} text-2xl text-accent`}
                      lang={l.lang}
                      dir={l.dir}
                    >
                      {l.name.native}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ))}
  </section>

  <section aria-labelledby="tools-heading" class="mx-auto mt-10 max-w-3xl">
    <h2 id="tools-heading" class="mb-4 text-xl font-semibold">
      Tools
    </h2>
    <ul class="grid gap-3 sm:grid-cols-2">
      <li>
        <a
          href="/typing"
          class="flex h-full flex-col gap-1 rounded-xl border border-border bg-surface px-5 py-4 text-text no-underline hover:border-accent"
        >
          <span class="text-lg font-medium">Typing tests and tutors</span>
          <span class="text-sm text-muted">
            Learn the keyboard and check your speed, in every language here.
          </span>
        </a>
      </li>
      <li>
        <a
          href="/keyboard-tester"
          class="flex h-full flex-col gap-1 rounded-xl border border-border bg-surface px-5 py-4 text-text no-underline hover:border-accent"
        >
          <span class="text-lg font-medium">Keyboard tester</span>
          <span class="text-sm text-muted">
            Test every key, find your layout, and see hidden characters in any text.
          </span>
        </a>
      </li>
      <li>
        <a
          href="/inpage-to-unicode"
          class="flex h-full flex-col gap-1 rounded-xl border border-border bg-surface px-5 py-4 text-text no-underline hover:border-accent"
        >
          <span class="text-lg font-medium">InPage to Unicode converter</span>
          <span class="text-sm text-muted">
            Convert .inp files and InPage text to Unicode Urdu, and back.
          </span>
        </a>
      </li>
      <li>
        <a
          href="/case-converter"
          class="flex h-full flex-col gap-1 rounded-xl border border-border bg-surface px-5 py-4 text-text no-underline hover:border-accent"
        >
          <span class="text-lg font-medium">Case converter</span>
          <span class="text-sm text-muted">
            UPPER, lower, sentence and title case, with Turkish, German, Greek and Irish rules.
          </span>
        </a>
      </li>
      <li>
        <a
          href="/urdu-typing-test"
          class="flex h-full flex-col gap-1 rounded-xl border border-border bg-surface px-5 py-4 text-text no-underline hover:border-accent"
        >
          <span class="text-lg font-medium">Urdu typing test</span>
          <span class="text-sm text-muted">
            Check your Urdu typing speed in words per minute, and share your result.
          </span>
        </a>
      </li>
      <li>
        <a
          href="/urdu-typing-tutor"
          class="flex h-full flex-col gap-1 rounded-xl border border-border bg-surface px-5 py-4 text-text no-underline hover:border-accent"
        >
          <span class="text-lg font-medium">Urdu typing tutor</span>
          <span class="text-sm text-muted">
            Learn the Urdu keyboard row by row with free lessons.
          </span>
        </a>
      </li>
      <li>
        <a
          href="/cheat-sheets"
          class="flex h-full flex-col gap-1 rounded-xl border border-border bg-surface px-5 py-4 text-text no-underline hover:border-accent"
        >
          <span class="text-lg font-medium">Printable keyboard charts</span>
          <span class="text-sm text-muted">
            Every layout on one A4 page, to print or download as PDF.
          </span>
        </a>
      </li>
      <li>
        <a
          href="/guides"
          class="flex h-full flex-col gap-1 rounded-xl border border-border bg-surface px-5 py-4 text-text no-underline hover:border-accent"
        >
          <span class="text-lg font-medium">Urdu typing guides</span>
          <span class="text-sm text-muted">
            Set up Urdu on Windows, Mac and phones, and turn Roman Urdu into Urdu.
          </span>
        </a>
      </li>
    </ul>
  </section>
</Base>
