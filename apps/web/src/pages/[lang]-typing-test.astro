---
import type { Language } from "@okb/layouts";
import TypingPage from "../components/typing/TypingPage.astro";
import TypingTest from "../components/typing/TypingTest";
import { TYPING_COPY } from "../content/typing/copy";
import { TYPING_LANGUAGES, practiceText, typingLayouts } from "../content/typing/practice";
import { SITE } from "../config/site";
import { scoringFor } from "../components/typing/drill";

/** Typing tests for every language with a key layout (/urdu-typing-test has its own page). */
export function getStaticPaths() {
  return TYPING_LANGUAGES.map((language) => ({
    params: { lang: language.slug },
    props: { language },
  }));
}

const { language: l } = Astro.props as { language: Language };
const copy = TYPING_COPY[l.code]!;
const name = l.name.en;
const latin = l.script === "Latn";
const text = await practiceText(l);
const sentences = text.passages.length > 0;
const unit = scoringFor(l.script).unit;
const layouts = typingLayouts(l);
const layoutNames = layouts.map((x) => x.name.en);
const listed =
  layoutNames.length > 1
    ? `${layoutNames.slice(0, -1).join(", ")} or ${layoutNames.at(-1)}`
    : layoutNames[0]!;
const easy = layouts.find((x) => x.id.endsWith("-easy"))?.name.en;

const steps = [
  `Pick a layout (${listed}), a length (30 seconds, 1 or 2 minutes)${sentences ? " and the text: common words or sentences" : ""}.`,
  "Start typing the highlighted word. The clock starts with your first key. Press Space after each word.",
  "Correct words turn green and wrong ones red. When the time is up you see your speed in words per minute and your accuracy.",
  "Download or share your result as an image, then try again to beat your best.",
];

const SPEED_RULE = {
  letters:
    "Like most typing tests: every 5 characters you type correctly, spaces included, count as one word. A letter with an accent or a mark counts once, however many keys it took. Your speed is those words divided by the minutes taken. Words with a mistake in them do not count. Raw speed counts every key you pressed, right or wrong.",
  indic:
    "Every 5 characters you type correctly, spaces included, count as one word. A vowel sign and the virama count as characters of their own, because each is a key: कि is two, क्ष three. Your speed is those words divided by the minutes taken. Words with a mistake in them do not count. Raw speed counts every key you pressed, right or wrong.",
} as const;

const faqs = [
  {
    q: `How is ${name} typing speed (WPM) worked out?`,
    a: SPEED_RULE[l.script === "Deva" || l.script === "Beng" ? "indic" : "letters"],
  },
  {
    q: "What is a good typing speed?",
    a: latin
      ? "Around 30 to 40 words per minute is a comfortable everyday speed, and 60 or more is fast. Accented letters take an extra key on some layouts, so expect a few words per minute less than in English at first."
      : `Around 20 to 30 words per minute is a comfortable everyday speed in ${name}, and 40 or more is fast. Accuracy matters more than speed when you start: aim for 95% and the speed follows with practice.`,
  },
  {
    q: `Do I need a ${name} keyboard?`,
    a: easy
      ? `No. Choose ${easy} and your English keyboard types every ${name} letter: the accent key first, then the letter. If your computer or phone already types ${name}, tick “My device already types ${name}”.`
      : `No. Choose a layout here and your keyboard types the ${name} letters; the on-screen keyboard shows which key types which. If your computer or phone already types ${name}, tick “My device already types ${name}”.`,
  },
  {
    q: `Which ${name} letters slow people down?`,
    a: copy.tip,
  },
  {
    q: "Can I take the test on my phone?",
    a: `Yes. On a phone the on-screen ${name} keyboard appears below the text, or tick “My device already types ${name}” to use your phone's own keyboard.`,
  },
  {
    q: "Where are my results saved?",
    a: "Only on your device. Your best speed for each layout and test length is kept in your browser, with separate bests on phones; nothing is uploaded.",
  },
];
---

<TypingPage
  title={`${name} Typing Test: Check Your ${name} Typing Speed (WPM) Online | ${SITE.name}`}
  description={`Free ${name} typing speed test. Type common words${sentences ? " or real sentences" : ""} on the ${listed} keyboard, see your ${unit === "wpm" ? "WPM" : "speed"} and accuracy, and share your result.`}
  heading={`${name} Typing Test`}
  headingNative={copy.test}
  intro={`How fast can you type ${name}${latin ? ", accents and all" : ""}? Take a 30-second, 1-minute or 2-minute test with common words${sentences ? " or everyday sentences" : ""}, using your own keyboard or the one on screen.`}
  appName={`${name} Typing Test`}
  howToName={`How to take the ${name} typing test`}
  steps={steps}
  about={{
    heading: "Practise to get faster",
    paragraphs: [
      `Typing speed comes from knowing where every letter is without looking. If you are still searching for keys, the typing tutor teaches the keyboard one row at a time${latin ? ", accents last" : ""}.`,
      "Short daily practice beats long sessions: a few 1-minute tests a day will raise your speed within weeks.",
      `The words are the ${text.words.length} most common in the ${name} ${l.wordList ? "word list" : "Tatoeba sentences"}.${sentences ? " The sentences are from Tatoeba, credited below." : ""}`,
    ],
  }}
  faqs={faqs}
  related={[
    { href: `/${l.slug}-typing-tutor`, label: `${name} typing tutor: learn the keyboard` },
    { href: `/${l.slug}`, label: `${name} keyboard: type and save your text` },
  ]}
  slug={l.slug}
  lang={l.lang}
  dir={l.dir}
  font={l.fonts[0]}
  tatoeba={sentences}
>
  <TypingTest
    client:idle={{ timeout: 500 }}
    slug={l.slug}
    lang={l.lang}
    languageName={name}
    nativeName={l.name.native}
    nativeTitle={copy.test}
    title={`${name} typing test`}
    layouts={layouts}
    words={text.words}
    passages={text.passages}
    dir={l.dir}
    font={l.fonts[0]}
    script={l.script}
  />
</TypingPage>
