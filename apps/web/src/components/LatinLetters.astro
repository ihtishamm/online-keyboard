---
/**
 * The special letters of a Latin-script language, and how to type each one without this site
 * (plan items 5.4 and 7.5). Generated from data: the Windows keys come from our US-International
 * layout (its dead keys and AltGr layer), Alt codes from the Windows-1252 code page, and Mac
 * keys from the letter's accent (Option+E for an acute, and so on).
 */
import { US_QWERTY, type KeyCode } from "@okb/engine";
import type { Layout } from "@okb/engine/layout";

interface Props {
  /** The language's special letters (language.json `accents`). */
  accents: string;
  lang: string;
  languageName: string;
  /** The US-International layout ("Easy accents"), for the Windows column. */
  usIntl: Layout;
  /** The language's own Windows layout, for letters US-International cannot type. */
  national?: Layout;
}

const { accents, lang, languageName, usIntl, national } = Astro.props;

/** The key that types `char` on a layer, as "Shift+6" or "AltGr+N" (named as on US keys). */
function keyFor(char: string, layout: Layout = usIntl): string | null {
  const layers = [
    ["n", ""],
    ["s", "Shift+"],
    ["ag", "AltGr+"],
    ["sag", "Shift+AltGr+"],
  ] as const;
  for (const [layer, prefix] of layers) {
    for (const [code, def] of Object.entries(layout.keys) as [KeyCode, Record<string, string>][]) {
      if (def?.[layer] === char) {
        const legend = US_QWERTY[code][0]!;
        return prefix + (/[a-z]/.test(legend) ? legend.toUpperCase() : legend);
      }
    }
  }
  return null;
}

/**
 * How one layout types a letter: US-International's accent keys first (' then e, as people
 * learn it), a national layout's own key first (ř on 5), else a dead key and the letter.
 */
function keysOn(layout: Layout, char: string, deadFirst = false): string | null {
  const direct = keyFor(char, layout);
  if (direct && !deadFirst) return direct;
  const dead = layout.deadkeys.find((d) => d.out === char);
  if (dead) {
    const trigger = keyFor(dead.trigger, layout);
    const base = keyFor(dead.base, layout);
    if (trigger && base) return `${trigger}, then ${base}`;
  }
  return direct;
}

/** Windows US-International, else the language's own Windows layout, by name. */
function windowsKeys(char: string): string {
  const us = keysOn(usIntl, char, true);
  if (us) return us;
  const own = national && keysOn(national, char);
  return own ? `${national!.name.en}: ${own}` : "–";
}

/** Alt codes type Windows-1252 characters on any Windows keyboard (number pad). */
const CP1252 = new Map<string, number>();
const decoder = new TextDecoder("windows-1252");
for (let b = 0x80; b <= 0xff; b++) CP1252.set(decoder.decode(new Uint8Array([b])), b);
const altCode = (char: string) => {
  const b = CP1252.get(char);
  return b === undefined ? "–" : `Alt+0${b}`;
};

/** Mac (US or ABC layout): Option with the accent's key, then the letter. */
const MAC_ACCENT: Record<string, string> = {
  "́": "Option+E",
  "̀": "Option+`",
  "̂": "Option+I",
  "̈": "Option+U",
  "̃": "Option+N",
};
const MAC_DIRECT: Record<string, string> = {
  ç: "Option+C",
  Ç: "Option+Shift+C",
  œ: "Option+Q",
  Œ: "Option+Shift+Q",
  æ: "Option+'",
  Æ: "Option+Shift+'",
  ß: "Option+S",
  å: "Option+A",
  Å: "Option+Shift+A",
  ø: "Option+O",
  Ø: "Option+Shift+O",
  "¿": "Option+Shift+/",
  "¡": "Option+1",
  "«": "Option+\\",
  "»": "Option+Shift+\\",
};
function macKeys(char: string): string {
  if (MAC_DIRECT[char]) return MAC_DIRECT[char];
  const [base, mark, ...rest] = [...char.normalize("NFD")];
  const accent = mark && !rest.length ? MAC_ACCENT[mark] : undefined;
  if (!base || !accent) return "–";
  return `${accent}, then ${base === base.toUpperCase() ? `Shift+${base}` : base.toUpperCase()}`;
}

/** Phones: hold the plain letter (or the mark) for its accented forms. */
const PHONE_BASE: Record<string, string> = {
  "¿": "?",
  "¡": "!",
  "«": '"',
  "»": '"',
  æ: "a",
  œ: "o",
};
function phoneKeys(char: string): string {
  const base = PHONE_BASE[char.toLowerCase()] ?? char.normalize("NFD")[0]!;
  return base === char ? "–" : `Hold ${base}`;
}

const chars = [...accents].filter((c) => !/\p{L}/u.test(c) || c === c.toLowerCase());
const rows = chars.flatMap((c) => {
  const upper = /\p{L}/u.test(c) ? c.toLocaleUpperCase(lang) : null;
  return [c, ...(upper && upper !== c && accents.includes(upper) ? [upper] : [])];
});
/** The national layout is named only where US-International lacks a letter it has. */
const viaNational = national && rows.some((c) => !keysOn(usIntl, c, true) && keysOn(national, c));
---

<section aria-labelledby="letters-heading" class="mt-10 max-w-3xl">
  <h2 id="letters-heading" class="mb-2 text-xl font-semibold">
    {languageName} letters, and how to type them anywhere
  </h2>
  <p class="mb-3 text-sm text-muted">
    On this page, tap a letter in the bar above the keyboard, or type it plain and let smart accents
    add the accent. In other apps: on Windows, choose the United States-International keyboard in
    Settings{viaNational && ` (or ${national!.name.en}, for the letters it lacks)`}, then use the
    keys below, or hold Alt and type the code on the number pad. On a Mac, hold Option, or add the
    {languageName} keyboard. On phones, hold the plain letter.
  </p>
  <div
    class="overflow-x-auto rounded-xl border border-border"
    role="region"
    aria-labelledby="letters-heading"
    tabindex="0"
  >
    <table class="w-full text-sm">
      <thead class="bg-surface-2 text-left">
        <tr>
          <th scope="col" class="px-3 py-2">
            Letter
          </th>
          <th scope="col" class="px-3 py-2">
            Windows
          </th>
          <th scope="col" class="px-3 py-2">
            Windows Alt code
          </th>
          <th scope="col" class="px-3 py-2">
            Mac
          </th>
          <th scope="col" class="px-3 py-2">
            Phone
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-surface">
        {rows.map((c) => (
          <tr>
            <th scope="row" class="px-3 py-1.5 text-lg font-medium" lang={lang}>
              {c}
            </th>
            <td class="px-3 py-1.5 font-mono text-xs">{windowsKeys(c)}</td>
            <td class="px-3 py-1.5 font-mono text-xs">{altCode(c)}</td>
            <td class="px-3 py-1.5 font-mono text-xs">{macKeys(c)}</td>
            <td class="px-3 py-1.5 text-xs">{phoneKeys(c)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-2 text-xs text-muted">
    “–”: no shortcut on that system. Add the {languageName} keyboard in your system settings, or
    copy the letter from here.
  </p>
</section>
