---
import "@fontsource/noto-naskh-arabic/400.css";
import "@fontsource/noto-nastaliq-urdu/400.css";
import "@fontsource/noto-sans-bengali/400.css";
import "@fontsource/noto-sans-devanagari/400.css";
import { getLanguage, getLayout, layoutSlug } from "@okb/layouts";
import { getCollection } from "astro:content";
import { FONT_CLASS } from "./fonts";
import KeyboardApp from "./keyboard/KeyboardApp";
import { allSheets, pdfPath, sheetPath } from "./cheatsheet/sheets";
import LayoutChart from "./LayoutChart.astro";
import RomanGuide from "./RomanGuide.astro";
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";
import { copyFor } from "../content/languages";

interface Props {
  slug: string;
  layoutId: string;
}

const { slug, layoutId } = Astro.props;
const language = getLanguage(slug);
const layout = getLayout(layoutId);
const copy = copyFor(slug);
const isDefault = layoutId === language.layouts[0];
const layoutCopy = copy.layouts[layoutId];
const otherLayouts = language.layouts.filter((id) => id !== layoutId);
const sheet = allSheets().find((s) => s.layoutId === layoutId);
const guides = (await getCollection("guides", (g) => g.data.language === slug)).sort(
  (a, b) => a.data.order - b.data.order,
);
const layoutGuide = guides.find((g) => g.data.layout === layoutId);

const title = isDefault
  ? copy.title
  : layoutCopy?.title
    ? `${layoutCopy.title} | ${SITE.name}`
    : `${language.name.en} ${layout.name.en} Keyboard Online (${layout.name.native}) | ${SITE.name}`;
const description = isDefault
  ? copy.description
  : (layoutCopy?.description ??
    `Type ${language.name.en} online with the ${layout.name.en} layout. ${layoutCopy?.summary ?? ""}`);
const heading = isDefault
  ? copy.heading
  : (layoutCopy?.heading ?? `${language.name.en} ${layout.name.en} Keyboard`);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: `${SITE.name} ${language.name.en} Keyboard`,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any (web browser)",
    inLanguage: language.lang,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    url: new URL(Astro.url.pathname, Astro.site).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: copy.faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base title={title} description={description} nastaliq={language.fonts.includes("nastaliq")}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{heading}</h1>
    <span
      class={`${FONT_CLASS[language.fonts[0]!]} text-2xl text-accent`}
      lang={language.lang}
      dir={language.dir}
    >
      {copy.headingNative}
    </span>
  </div>
  <p class="mb-5 max-w-3xl text-sm text-muted sm:text-base">{copy.intro}</p>

  {/* Hydrate after first paint (capped at 500 ms) so React never delays the static render. */}
  <KeyboardApp
    client:idle={{ timeout: 500 }}
    slug={slug}
    layoutId={layoutId}
    explicitLayout={!isDefault}
  />

  <div class="below-fold mt-12 grid grid-cols-1 gap-10 lg:grid-cols-[2fr_1fr]">
    <section aria-labelledby="layout-heading" class="min-w-0">
      <h2 id="layout-heading" class="mb-2 text-xl font-semibold">
        {layout.name.en} layout{" "}
        <span class="font-script" lang={language.lang}>
          ({layout.name.native})
        </span>
      </h2>
      {layoutCopy && <p class="mb-1 max-w-2xl">{layoutCopy.summary}</p>}
      {layoutCopy && (
        <p class="mb-4 max-w-2xl text-sm text-muted">Best for: {layoutCopy.bestFor}</p>
      )}
      {layout.translit && copy.romanGuide ? (
        <RomanGuide rows={copy.romanGuide} lang={language.lang} />
      ) : (
        <LayoutChart layout={layout} />
      )}
      {layoutGuide && (
        <p class="mt-3 text-sm">
          <a class="text-accent underline" href={`/guides/${layoutGuide.id}`}>
            Full guide: {layoutGuide.data.heading ?? layoutGuide.data.title}
          </a>
        </p>
      )}
      {sheet && (
        <p class="mt-3 text-sm">
          <a class="text-accent underline" href={sheetPath(sheet.id)}>
            Printable {layout.translit ? "Roman Urdu" : layout.name.en} chart
          </a>{" "}
          (
          <a class="text-accent underline" href={pdfPath(sheet.id)} download>
            PDF
          </a>
          )
        </p>
      )}
      {otherLayouts.length > 0 && (
        <p class="mt-3 text-sm text-muted">
          Other layouts:{" "}
          {otherLayouts.map((id, i) => (
            <>
              {i > 0 && ", "}
              <a
                class="text-accent underline"
                href={id === language.layouts[0] ? `/${slug}` : `/${slug}/${layoutSlug(id)}`}
              >
                {getLayout(id).name.en}
              </a>
            </>
          ))}
        </p>
      )}
      <p class="mt-3 text-xs text-muted">Layout source: {layout.source}</p>
    </section>

    <section aria-labelledby="tips-heading" class="min-w-0">
      <h2 id="tips-heading" class="mb-3 text-xl font-semibold">
        Tips
      </h2>
      <ul class="list-disc space-y-2 ps-5">
        {copy.tips.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
      {slug === "urdu" && (
        <p class="mt-4 text-sm">
          Practise:{" "}
          <a class="text-accent underline" href="/urdu-typing-tutor">
            Urdu typing tutor
          </a>{" "}
          ·{" "}
          <a class="text-accent underline" href="/urdu-typing-test">
            Urdu typing test
          </a>
        </p>
      )}
      {guides.length > 0 && (
        <nav aria-labelledby="guides-heading" class="mt-6">
          <h2 id="guides-heading" class="mb-2 text-base font-semibold">
            Guides
          </h2>
          <ul class="space-y-1 text-sm">
            {guides.map((g) => (
              <li>
                <a class="text-accent underline" href={`/guides/${g.id}`}>
                  {g.data.heading ?? g.data.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </section>
  </div>

  <section aria-labelledby="faq-heading" class="below-fold mt-12 max-w-3xl">
    <h2 id="faq-heading" class="mb-3 text-xl font-semibold">
      Frequently asked questions
    </h2>
    <div class="divide-y divide-border rounded-xl border border-border bg-surface">
      {copy.faqs.map((f) => (
        <details class="group px-4 py-3">
          <summary class="cursor-pointer font-medium">{f.q}</summary>
          <p class="mt-2 text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
