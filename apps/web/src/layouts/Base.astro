---
import "@fontsource-variable/inter";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import LanguagePicker from "../components/picker/LanguagePicker";
import { pickerLanguage } from "../components/picker/languages";
import { LANGUAGES, REGIONS, type FontId } from "@okb/layouts";
import { fontFaces } from "../styles/script-fonts";
import { SITE } from "../config/site";

interface Props {
  title: string;
  description?: string;
  /** Language of the page's main content (the UI chrome is English). */
  lang?: string;
  /**
   * Fetch the Nastaliq font once the page is idle. Pages for languages not written in Nastaliq
   * skip the download; the logo then stays in Naskh unless the font is already cached.
   */
  nastaliq?: boolean;
  /**
   * The page language's default font. Key caps and other `font-script` text then use that
   * font's stack only, and pages in other scripts draw the Urdu logo with system fonts, so
   * each page downloads only its own script's fonts.
   */
  font?: FontId;
  /** Script fonts whose @font-face rules the page carries (src/styles/script-fonts.ts). */
  fonts?: readonly FontId[];
  /** Keep the page out of search results (utility pages such as /share). */
  noindex?: boolean;
  /**
   * Sources of the word list the page's language uses, credited in the footer: its Wikipedia
   * (name and subdomain) and, for Hindi, Bangla and Sindhi chat spellings, Dakshina.
   */
  credits?: {
    wikipedia?: { name: string; code: string };
    dakshina?: boolean;
    aksharantar?: boolean;
    wiktionary?: boolean;
    tatoeba?: boolean;
  };
  /** Slug of the page's language, marked as current in the language picker. */
  language?: string;
}

const {
  title,
  description = SITE.description,
  lang = "en",
  nastaliq = true,
  font,
  fonts = [],
  noindex = false,
  credits = { wikipedia: { name: "Urdu", code: "ur" } },
  language,
} = Astro.props;
const pickerLanguages = LANGUAGES.map(pickerLanguage);
const regions = Object.entries(REGIONS);
const canonical = new URL(Astro.url.pathname, Astro.site);
const faces = fontFaces(fonts);
// The logo is Urdu: in Nastaliq on Arabic-script pages and pages of no one script.
const arabicLogo = font === undefined || font === "nastaliq" || font === "naskh";
---

<!doctype html>
<html
  lang={lang}
  style={font ? `--stack-script: var(--stack-${font === "nastaliq" ? "naskh" : font})` : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {faces && <style set:html={faces} />}
    <meta name="theme-color" content="#0f6b5c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline define:vars={{ fetchNastaliq: nastaliq }}>
      // Nastaliq: apply at once if this browser has loaded it before (it is in the HTTP cache);
      // otherwise fetch it when the page is idle, then swap it in. See .font-nastaliq in CSS.
      (() => {
        const KEY = "likho:nastaliq";
        const root = document.documentElement;
        const ready = () => root.classList.add("nastaliq-ready");
        try {
          if (localStorage.getItem(KEY) === "1") ready();
        } catch {
          /* storage unavailable: load on idle below */
        }
        if (!fetchNastaliq) return;
        if (!document.fonts?.load) return ready();
        const load = () =>
          document.fonts.load('1em "Noto Nastaliq Urdu"', "\u0627\u0628").then(() => {
            ready();
            try {
              localStorage.setItem(KEY, "1");
            } catch {
              /* storage unavailable: next visit loads on idle again */
            }
          });
        const idle = () =>
          window.requestIdleCallback
            ? requestIdleCallback(load, { timeout: 1500 })
            : setTimeout(load, 200);
        if (document.readyState === "complete") idle();
        else window.addEventListener("load", idle);
      })();
    </script>
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const t = localStorage.getItem("likho:theme");
        if (t === "light" || t === "dark" || t === "contrast") {
          document.documentElement.dataset.theme = t;
        }
      } catch {
        /* storage unavailable: follow the system theme */
      }
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <header class="border-b border-border bg-surface">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex h-10 items-center gap-2 text-text no-underline">
          <span class="text-xl font-semibold tracking-tight">{SITE.name}</span>
          <span
            class:list={[
              "text-lg text-accent",
              arabicLogo ? "font-nastaliq" : "font-system-arabic",
            ]}
            lang="ur"
            dir="rtl"
          >
            {SITE.nameNative}
          </span>
        </a>
        <div class="flex items-center gap-2">
          <LanguagePicker
            client:idle
            languages={pickerLanguages}
            regions={regions}
            current={language}
          />
          <ThemeSwitcher />
        </div>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6">
      <slot />
    </main>
    <footer class="border-t border-border bg-surface text-sm text-muted">
      <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-2 px-4 py-4">
        <p>
          © {new Date().getFullYear()} {SITE.name}. Your text stays on your device.
          <span id="offline-ready" hidden>
            {" "}
            Pages you open work offline.
          </span>
        </p>
        {credits.wikipedia && (
          <p>
            {"Word suggestions use a word list built from "}
            <a class="underline" href={`https://${credits.wikipedia.code}.wikipedia.org/`}>
              {`${credits.wikipedia.name} Wikipedia`}
            </a>
            {credits.wiktionary && " and spellings from "}
            {credits.wiktionary && (
              <a class="underline" href="https://en.wiktionary.org/">
                English Wiktionary
              </a>
            )}
            {credits.dakshina && " and chat spellings from the "}
            {credits.dakshina && (
              <a class="underline" href="https://github.com/google-research-datasets/dakshina">
                Dakshina dataset (Google Research)
              </a>
            )}
            {" ("}
            <a class="underline" href="https://creativecommons.org/licenses/by-sa/4.0/">
              CC BY-SA 4.0
            </a>
            {")"}
            {credits.aksharantar && " and chat spellings from "}
            {credits.aksharantar && (
              <a class="underline" href="https://huggingface.co/datasets/ai4bharat/Aksharantar">
                AI4Bharat Aksharantar
              </a>
            )}
            {credits.aksharantar && " ("}
            {credits.aksharantar && (
              <a class="underline" href="https://creativecommons.org/about/cclicenses/">
                CC BY
              </a>
            )}
            {credits.aksharantar && ")"}
            {credits.tatoeba && " and everyday sentences from "}
            {credits.tatoeba && (
              <a class="underline" href="https://tatoeba.org/">
                Tatoeba
              </a>
            )}
            {credits.tatoeba && " ("}
            {credits.tatoeba && (
              <a class="underline" href="https://creativecommons.org/licenses/by/2.0/fr/">
                CC BY 2.0 FR
              </a>
            )}
            {credits.tatoeba && ")"}
            {"."}
          </p>
        )}
        {!credits.wikipedia && credits.tatoeba && (
          <p>
            {"Practice sentences are from "}
            <a class="underline" href="https://tatoeba.org/">
              Tatoeba
            </a>
            {" ("}
            <a class="underline" href="https://creativecommons.org/licenses/by/2.0/fr/">
              CC BY 2.0 FR
            </a>
            {")."}
          </p>
        )}
      </div>
    </footer>
    {import.meta.env.PROD && <script is:inline>
      // Offline support (src/sw/service-worker.js). Production builds only: in development
      // a cached page would hide code changes.
      if ("serviceWorker" in navigator) {
        const sw = navigator.serviceWorker;
        // This page and the files it fetched before the worker controlled it, so they work
        // offline too.
        const handOver = () =>
          sw.controller?.postMessage({
            type: "cache",
            page: location.pathname,
            urls: performance
              .getEntriesByType("resource")
              .map((e) => e.name)
              .filter((url) => url.startsWith(location.origin)),
          });
        const ready = () => {
          const note = document.getElementById("offline-ready");
          if (note && sw.controller) note.hidden = false;
        };
        sw.addEventListener("controllerchange", () => {
          handOver();
          ready();
          // Requests still in flight at the switch finish later, outside the worker: hand
          // those over too as they arrive (the worker skips anything it already has).
          if ("PerformanceObserver" in window) {
            new PerformanceObserver(handOver).observe({ type: "resource" });
          }
        });
        ready();
        window.addEventListener("load", () => {
          sw.register("/sw.js").then(handOver, () => {
            /* unsupported or blocked: the site still works online */
          });
        });
      }
    </script>}
    <script>
      // Page views and field Web Vitals; a no-op unless PUBLIC_ANALYTICS_ENDPOINT is set.
      import { track } from "../analytics/track";
      import { reportVitals } from "../analytics/vitals";
      track("pageview");
      reportVitals();
    </script>
  </body>
</html>
