{
  "name": "@okb/script-converters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Script converters: Shahmukhi ↔ Gurmukhi and Urdu ↔ Hindi backed by word lists, and Serbian, Kazakh and Uzbek Cyrillic ↔ Latin.",
  "exports": {
    "./bridge": "./src/bridge.ts",
    "./punjabi": "./src/punjabi.ts",
    "./hindustani": "./src/hindustani.ts",
    "./serbian": "./src/serbian.ts",
    "./alphabet": "./src/alphabet.ts",
    "./kazakh": "./src/kazakh.ts",
    "./uzbek": "./src/uzbek.ts",
    "./data/*": "./data/*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@okb/engine": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
