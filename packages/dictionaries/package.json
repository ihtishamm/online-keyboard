{
  "name": "@okb/dictionaries",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Corpus pipeline and the word lists it builds (frequency-ranked words, next-word table).",
  "exports": {
    "./ur/words.txt": "./data/ur/words.txt",
    "./*/dict.txt": "./data/*/dict.txt",
    "./results/*.json": "./results/*.json",
    "./*/chat.tsv": "./data/*/chat.tsv",
    "./blocked": "./src/blocked.ts"
  },
  "scripts": {
    "build:words": "node src/build.ts",
    "build:ur": "node src/build.ts --lang ur",
    "eval:ur": "EVAL_VERBOSE=1 vitest run test/roman-eval.test.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "EVAL_VERBOSE=1 vitest run test/roman-langs.test.ts",
    "compact": "node src/compact.ts",
    "chat-words": "node src/chat-words.ts"
  },
  "dependencies": {
    "@okb/engine": "workspace:*",
    "@okb/layouts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
