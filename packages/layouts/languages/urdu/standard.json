{
  "id": "ur-standard",
  "lang": "ur",
  "script": "Arab",
  "dir": "rtl",
  "name": { "en": "Standard", "native": "معیاری" },
  "source": "Microsoft Windows Urdu keyboard layout (KBDURDU), as documented for Windows. AltGr and Shift+AltGr layers are Likho additions.",
  "keys": {
    "Backquote": { "n": "`", "s": "~" },
    "Digit1": { "n": "1", "s": "!", "ag": "۱" },
    "Digit2": { "n": "2", "s": "@", "ag": "۲" },
    "Digit3": { "n": "3", "s": "#", "ag": "۳" },
    "Digit4": { "n": "4", "s": "$", "ag": "۴" },
    "Digit5": { "n": "5", "s": "٪", "ag": "۵" },
    "Digit6": { "n": "6", "s": "^", "ag": "۶" },
    "Digit7": { "n": "7", "s": "&", "ag": "۷" },
    "Digit8": { "n": "8", "s": "٭", "ag": "۸" },
    "Digit9": { "n": "9", "s": "(", "ag": "۹" },
    "Digit0": { "n": "0", "s": ")", "ag": "۰" },
    "Minus": { "n": "-", "s": "_" },
    "Equal": { "n": "=", "s": "+" },

    "KeyQ": { "n": "ط", "s": "ظ" },
    "KeyW": { "n": "ص", "s": "ض", "ag": "\u0654" },
    "KeyE": { "n": "ھ", "s": "ذ", "ag": "\u0670" },
    "KeyR": { "n": "د", "s": "ڈ", "sag": "\u0612" },
    "KeyT": { "n": "ٹ", "s": "ث" },
    "KeyY": { "n": "پ", "s": "\u0651" },
    "KeyU": { "n": "ت", "s": "ۃ", "ag": "\u064F" },
    "KeyI": { "n": "ب", "s": "ـ", "ag": "\u0650" },
    "KeyO": { "n": "ج", "s": "چ", "ag": "\u0652" },
    "KeyP": { "n": "ح", "s": "خ" },
    "BracketLeft": { "n": "[", "s": "{" },
    "BracketRight": { "n": "]", "s": "}" },
    "Backslash": { "n": "\\", "s": "|" },

    "KeyA": { "n": "م", "s": "ژ", "ag": "\u064E", "sag": "\u0611" },
    "KeyS": { "n": "و", "s": "ز", "sag": "ﷺ" },
    "KeyD": { "n": "ر", "s": "ڑ" },
    "KeyF": { "n": "ن", "s": "ں" },
    "KeyG": { "n": "ل", "s": "ۂ" },
    "KeyH": { "n": "ہ", "s": "ء" },
    "KeyJ": { "n": "ا", "s": "آ", "ag": "أ" },
    "KeyK": { "n": "ک", "s": "گ" },
    "KeyL": { "n": "ی", "s": "ي" },
    "Semicolon": { "n": "؛", "s": ":" },
    "Quote": { "n": "'", "s": "\"" },

    "KeyZ": { "n": "ق", "s": "\u200D", "sag": "\u0613" },
    "KeyX": { "n": "ف", "s": "\u200C" },
    "KeyC": { "n": "ے", "s": "ۓ" },
    "KeyV": { "n": "س", "s": "\u200E" },
    "KeyB": { "n": "ش", "s": "ؤ", "sag": "﷽" },
    "KeyN": { "n": "غ", "s": "ئ", "ag": "\u064B" },
    "KeyM": { "n": "ع", "s": "\u200F" },
    "Comma": { "n": "،", "s": "<" },
    "Period": { "n": "۔", "s": ">", "ag": "." },
    "Slash": { "n": "/", "s": "؟" }
  },
  "longpress": {
    "KeyJ": ["آ", "أ", "إ", "\u0670"],
    "KeyL": ["ئ", "ي", "ے"],
    "KeyH": ["ۂ", "ۃ", "ھ", "ه", "ء"],
    "KeyS": ["ؤ", "ز"],
    "KeyC": ["ۓ"],
    "KeyF": ["ں"],
    "KeyK": ["گ"],
    "KeyR": ["ڈ", "ذ"],
    "KeyD": ["ڑ", "ز", "ژ"],
    "KeyU": ["ۃ", "ث"],
    "KeyT": ["ث"],
    "Comma": ["؟", "؛", "۔", "!"]
  }
}
