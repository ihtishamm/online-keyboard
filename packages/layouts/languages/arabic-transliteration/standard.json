    "BracketLeft": {
      "n": "[",
      "s": "{",
      "ag": "ʻ"
    },
    "BracketRight": {
      "n": "]",
      "s": "}",
      "ag": "ʼ"
    },
    "Backslash": {
      "n": "\\",
      "s": "|"
    },
    "KeyA": {
      "n": "a",
      "s": "A",
      "caps": "shift",
      "ag": "ā",
      "sag": "Ā"
    },
    "KeyS": {
      "n": "s",
      "s": "S",
      "caps": "shift",
      "ag": "ṣ",
      "sag": "Ṣ"
    },
    "KeyD": {
