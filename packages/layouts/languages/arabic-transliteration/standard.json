      "s": "G",
      "caps": "shift",
      "ag": "ġ",
      "sag": "Ġ"
    },
    "KeyH": {
      "n": "h",
      "s": "H",
      "caps": "shift",
      "ag": "ḥ",
      "sag": "Ḥ"
    },
    "KeyJ": {
      "n": "j",
      "s": "J",
      "caps": "shift",
      "ag": "ǧ",
      "sag": "Ǧ"
    },
    "KeyK": {
