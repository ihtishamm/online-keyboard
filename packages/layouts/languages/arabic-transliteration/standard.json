    "KeyZ": {
      "n": "z",
      "s": "Z",
      "caps": "shift",
      "ag": "ẓ",
      "sag": "Ẓ"
    },
    "KeyX": {
      "n": "x",
      "s": "X",
      "caps": "shift"
    },
    "KeyC": {
      "n": "c",
      "s": "C",
      "caps": "shift"
    },
    "KeyV": {
      "n": "v",
      "s": "V",
      "caps": "shift"
    },
    "KeyB": {
      "n": "b",
      "s": "B",
      "caps": "shift"
    },
    "KeyN": {
      "n": "n",
      "s": "N",
      "caps": "shift"
    },
    "KeyM": {
      "n": "m",
      "s": "M",
      "caps": "shift"
    },
    "Comma": {
      "n": ",",
      "s": "<"
    },
    "Period": {
      "n": ".",
      "s": ">"
    },
    "Slash": {
      "n": "/",
      "s": "?"
    }
  },
  "rules": [
    {
      "before": "a",
      "typed": "=",
      "add": "ā",
      "remove": 1
    },
    {
