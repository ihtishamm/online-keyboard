{
  "id": "arl-standard",
  "lang": "ar-Latn",
  "script": "Latn",
  "dir": "ltr",
  "name": {
    "en": "Romanisation",
    "native": "Romanisation"
  },
  "source": "Ours: US QWERTY with DIN 31635 letters. = after a letter adds its mark (h= ḥ, a= ā), a second = its other form (h== ḫ, s== š, t== ṯ, d== ḏ, g== ǧ); ` types ʿ and Shift+` ʾ. AltGr types the marked letters at once, and AltGr+[ ] the ALA-LC ʻ ʼ.",
  "keys": {
    "Backquote": {
      "n": "ʿ",
      "s": "ʾ",
      "ag": "`",
      "sag": "~"
    },
    "Digit1": {
      "n": "1",
      "s": "!"
    },
    "Digit2": {
      "n": "2",
      "s": "@"
    },
    "Digit3": {
      "n": "3",
      "s": "#"
    },
    "Digit4": {
      "n": "4",
      "s": "$"
    },
    "Digit5": {
      "n": "5",
      "s": "%"
    },
    "Digit6": {
      "n": "6",
      "s": "^"
    },
    "Digit7": {
      "n": "7",
      "s": "&"
    },
    "Digit8": {
      "n": "8",
      "s": "*"
    },
    "Digit9": {
      "n": "9",
      "s": "("
    },
    "Digit0": {
      "n": "0",
      "s": ")"
    },
    "Minus": {
      "n": "-",
      "s": "_"
    },
    "Equal": {
      "n": "=",
      "s": "+"
    },
    "KeyQ": {
      "n": "q",
      "s": "Q",
      "caps": "shift"
    },
    "KeyW": {
      "n": "w",
      "s": "W",
      "caps": "shift"
    },
    "KeyE": {
      "n": "e",
      "s": "E",
      "caps": "shift",
      "ag": "ē",
      "sag": "Ē"
    },
    "KeyR": {
      "n": "r",
      "s": "R",
      "caps": "shift"
    },
    "KeyT": {
      "n": "t",
      "s": "T",
      "caps": "shift",
      "ag": "ṭ",
      "sag": "Ṭ"
    },
    "KeyY": {
      "n": "y",
      "s": "Y",
      "caps": "shift"
    },
    "KeyU": {
      "n": "u",
      "s": "U",
      "caps": "shift",
